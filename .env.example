NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional override for the documented NASA Mars Trek WMTS base.
NEXT_PUBLIC_MARS_TILE_BASE=https://trek.nasa.gov/tiles/Mars/EQ/Mars_MGS_MOLA_ClrShade_merge_global_463m/1.0.0/default/default028mm

# Optional: enables ARES generative briefings. Without it, the auditable local
# Monte Carlo engine and all recommendations continue to work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
